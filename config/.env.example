# Autojur
email_autojur=
senha_autojur=

# 2FA por e-mail (e-SAJ, Autojur)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
# IMAP_PASS: senha de APP do Gmail, não a senha normal da conta.
# Requer verificação em duas etapas ativa: https://myaccount.google.com/signinoptions/twosv
# Gerar a senha de app em: https://myaccount.google.com/apppasswords
IMAP_PASS=

# 2FA TOTP
TOTP_PDPJ=
TOTP_EPROC_TJMG=
TOTP_EPROC_TJSP=

# Opcional: Selenium remoto
# SELENIUM_REMOTE_URL=http://localhost:4444/wd/hub

# Opcional: pasta padrão visível na GUI
# ORGANIZADOR_PASTA_PADRAO=C:\Users\Usuario\Desktop\Processos
